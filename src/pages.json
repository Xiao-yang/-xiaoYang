{
	"easycom": {
        "autoscan": true,
        "custom": {
            "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
            "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
            "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
        }
    },
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "",
				"navigationBarBackgroundColor": "#b8d98e",
				"navigationBarTextStyle": "black"
			}
		},
		{
			"path": "pages/order/order",
			"style": {
				"navigationBarTitleText": ""
			}
		},
		{
			"path": "pages/my/my",
			"style": {
				"navigationBarTitleText": ""
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages-customer",
			"pages": [
				{
					"path": "apply/apply",
					"style": {
						"navigationBarTitleText": "申请成为摊主"
					}
				},
				{
					"path": "search/search",
					"style": {
						"navigationBarTitleText": "搜索"
					}
				},
				{
					"path": "shop-detail/shop-detail",
					"style": {
						"navigationBarTitleText": "店铺详情"
					}
				}
			]
		},
		{
			"root": "pages-vendor",
			"pages": [
				{
					"path": "goods/goods",
					"style": {
						"navigationBarTitleText": "商品管理"
					}
				},
				{
					"path": "goods-edit/goods-edit",
					"style": {
						"navigationBarTitleText": "新增商品"
					}
				},
				{
					"path": "shop/shop",
					"style": {
						"navigationBarTitleText": "店铺管理"
					}
				}
			]
		},
		{
			"root": "pages-admin",
			"pages": [
				{
					"path": "apply-audit/apply-audit",
					"style": {
						"navigationBarTitleText": "摊主申请审核"
					}
				},
				{
					"path": "customer/customer",
					"style": {
						"navigationBarTitleText": "客户管理"
					}
				},
				{
					"path": "vendor/vendor",
					"style": {
						"navigationBarTitleText": "摊主管理"
					}
				}
			]
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar": {
		"color": "#4b4b4b",
		"selectedColor": "#b8d98e",
		"borderStyle": "black",
		"backgroundColor": "#FFFFFF",
		"list": [
			{
				"pagePath": "pages/index/index",
				"iconPath": "static/tabIcon/index.png",
				"selectedIconPath": "static/tabIcon/indexSelect.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/order/order",
				"iconPath": "static/tabIcon/order.png",
				"selectedIconPath": "static/tabIcon/orderSelect.png",
				"text": "订单"
			},
			{
				"pagePath": "pages/my/my",
				"iconPath": "static/tabIcon/my.png",
				"selectedIconPath": "static/tabIcon/mySelect.png",
				"text": "我的"
			}
		]
	}
}
